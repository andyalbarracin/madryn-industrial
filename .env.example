# ══════════════════════════════════════════════════════════════════════════
#  MADRYN — plantilla de entorno.  SIN VALORES REALES.
#
#  Copiá a `apps/web/.env.local` (web) y a `ingestion/.env` (ingesta).
#  Ninguno de los dos va al repo: `.gitignore` ya los excluye.
#
#  REGLA DURA: `SUPABASE_SERVICE_ROLE_KEY` es server-only. Jamás en una
#  variable `NEXT_PUBLIC_*`, jamás importada desde un Client Component.
#  Todo lo que empieza con NEXT_PUBLIC_ se incrusta en el bundle del
#  navegador y es público de hecho.
# ══════════════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────────────
# Proyecto propio de MADRYN (`madryn-dev`). NO reusar credenciales de la
# Suite (sas-trace / zaire-suite): son bases separadas por ADR-004.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Lo leen route handlers, Server Actions y la ingesta.
SUPABASE_SERVICE_ROLE_KEY=

# ── Gating de sub-superficies ─────────────────────────────────────────────
# Lista separada por comas que consume `isFeatureEnabled()`.
# Valores válidos: radar, entidades, curacion, watchlists, fuentes
# Se leen al BUILD: cambiarlas exige redeploy, no alcanza reiniciar.
NEXT_PUBLIC_ENABLED_FEATURES=radar,entidades,curacion,watchlists,fuentes

# ── Basemap self-hosted (ADR-006) ─────────────────────────────────────────
# Host público de sólo-lectura que sirve el PMTiles de Argentina, los glifos
# y los sprites. Es geografía pública derivada de OSM (ODbL), sin datos de
# tenant: va en bucket público porque MapLibre hace cientos de range requests
# por sesión y una signed URL de 60 s no sirve. El CSP allowlistea este host.
NEXT_PUBLIC_BASEMAP_URL=
# Nombre del archivo, con la fecha del build de Protomaps adentro. La fecha
# en el nombre es lo que habilita cachearlo como `immutable`.
NEXT_PUBLIC_BASEMAP_PMTILES=madryn-ar-YYYYMMDD.pmtiles

# ── Object storage RAW: Cloudflare R2 (ADR-002) ───────────────────────────
# Snapshots inmutables de cada descarga. Server-only, nunca en el cliente.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=madryn-raw
# Bucket separado, éste sí público, para el basemap.
R2_BUCKET_PUBLIC=madryn-public

# ── IA (opcional en el MVP) ───────────────────────────────────────────────
# OpenRouter para no quedar atado a un solo proveedor (FACTIBILIDAD §2).
OPENROUTER_API_KEY=

# ── Ingesta ───────────────────────────────────────────────────────────────
# Identificarse es obligatorio: los endpoints de OSM y varios CKAN rechazan
# User-Agents de navegador y piden contacto en su política de uso.
MADRYN_USER_AGENT=MADRYN-Ingesta/0.1 (+mailto:TU-MAIL-ACA)
