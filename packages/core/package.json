{
  "name": "@madryn/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MADRYN — lógica pura: gating, scoring, procedencia. Sin I/O, sin env, sin React.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
